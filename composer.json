{
    "name": "boxhead/craft-country-select-field",
    "description": "Country select field type.",
    "type": "craft-plugin",
    "version": "4.1.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "country select"
    ],
    "support": {
        "docs": "https://github.com/weareboxhead/craft-country-select-field/blob/v1/README.md",
        "issues": "https://github.com/weareboxhead/craft-country-select-field/issues"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Boxhead",
            "homepage": "https://boxhead.io"
        }
    ],
    "require": {
        "craftcms/cms": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "boxhead\\countryselect\\": "src/"
        }
    },
    "extra": {
        "name": "Country Select Field",
        "handle": "country-select-field",
        "hasCpSettings": false,
        "hasCpSection": false,
        "changelogUrl": "https://raw.githubusercontent.com/weareboxhead/craft-country-select-field/v1/CHANGELOG.md",
        "class": "boxhead\\countryselect\\CountrySelectField"
    },
    "config": {
        "platform": {
            "php": "8.0.2"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "require-dev": {
        "craftcms/phpstan": "dev-main",
        "craftcms/rector": "dev-main"
    }
}
